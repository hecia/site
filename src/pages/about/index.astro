---
import Layout from "@/layouts/main.astro"
import {
  getLangFromUrl,
  useTranslations,
} from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const members = [
  { name: "Roxanne Midorge", role: "Co-President", initials: "RM", image: "/members/roxanne-midorge.jpeg" },
  { name: "Joseph Benarroch", role: "Co-President", initials: "JB", image: "/members/joseph-benarroch.jpeg" },
  { name: "Sara Hadjadj", role: "Treasurer / VP Revenue & Events", initials: "SH", image: "/members/sara-hadjadj.jpeg" },
  { name: "Noa Nebot", role: "VP Institutional Relations", initials: "NN", image: "/members/noa-nebot.jpeg" },
  { name: "Hugo Roullet", role: "VP Deployment AI Intelligence", initials: "HR", image: "/members/hugo-roullet.jpeg" },
  { name: "Thomas Brunel", role: "VP Research", initials: "TB", image: "/members/thomas-brunel.jpeg" },
  { name: "Abdou-Ismaël Sy", role: "Head of SF Project", initials: "AS", image: "/members/abdou-ismael-sy.jpeg" },
  { name: "Camille Gaidier", role: "Head of HEC AI Diners", initials: "CG", image: "/members/camille-gaidier.jpeg" },
]
---

<Layout title={t("about.pageTitle")} description={t("about.description")}>
  <div class="container mx-auto px-4 md:px-8 py-12 md:py-20">
    <div class="max-w-3xl mb-16">
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4">{t("about.title")}</h1>
      <p class="text-xl text-muted-foreground">
        {t("about.subtitle")}
      </p>
    </div>

    <section id="bureau">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold tracking-tight mb-4">{t("about.bureau.title")}</h2>
        <p class="text-muted-foreground max-w-xl mx-auto">{t("about.bureau.subtitle")}</p>
      </div>
      <div class="flex flex-wrap justify-center gap-8">
        {members.map(member => (
          <div class="flex flex-col items-center text-center gap-4">
            <div class="relative group">
              <div class="w-32 h-32 md:w-36 md:h-36 rounded-full bg-primary/10 border-2 border-border overflow-hidden flex items-center justify-center">
                <img
                  src={member.image}
                  alt={member.name}
                  class="w-full h-full object-cover"
                  onerror={`this.style.display='none';this.nextElementSibling.style.display='flex'`}
                />
                <span class="text-3xl font-bold text-primary w-full h-full items-center justify-center hidden">{member.initials}</span>
              </div>
            </div>
            <div>
              <p class="font-semibold text-base leading-tight">{member.name}</p>
              <p class="text-sm text-muted-foreground mt-1">{member.role}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

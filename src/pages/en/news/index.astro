---
import Layout from "@/layouts/main.astro"
import { Card, CardHeader, CardTitle, CardDescription } from "@/components/ui/card"
import { Badge } from "@/components/ui/badge"
import { getCollection } from "astro:content"
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
  getDateLocale,
  filterByLocale,
  getSlugFromId,
  tDynamic,
} from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)

const allNews = await getCollection("news", ({ data }) => !data.draft)
const sortedNews = filterByLocale(allNews, lang).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)
const nonNewsletter = sortedNews.filter(item => item.data.category !== "newsletter")
const newsletterItems = sortedNews.filter(item => item.data.category === "newsletter")

const featuredItem = nonNewsletter.find(item => item.data.featured && item.data.image)
const news = featuredItem
  ? nonNewsletter.filter(item => item.id !== featuredItem.id)
  : nonNewsletter

const isLogo = (src) => src.startsWith("/logos/") || src === "/logo.jpg"
---

<Layout title={t("news.pageTitle")} description={t("news.description")}>
  <div class="container mx-auto px-4 md:px-8 py-12 md:py-20">
    <div class="max-w-3xl mb-12">
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4">{t("news.title")}</h1>
      <p class="text-xl text-muted-foreground">
        {t("news.subtitle")}
      </p>
    </div>

    {featuredItem && (
      <a
        href={`${translatePath("/news")}/${getSlugFromId(featuredItem.id)}`}
        class="group block mb-16 rounded-2xl overflow-hidden border border-border/50 hover:border-accent-yellow/60 transition-colors"
      >
        <div class="relative w-full aspect-[16/9] md:aspect-[21/9] overflow-hidden">
          <img
            src={featuredItem.data.image.src}
            alt={featuredItem.data.image.alt}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-background via-background/30 to-transparent" />
          <div class="absolute top-4 left-4">
            <Badge className="uppercase tracking-wider bg-accent-yellow text-background border-accent-yellow">
              {t("news.featured")}
            </Badge>
          </div>
        </div>
        <div class="p-6 md:p-8 bg-card">
          <time class="text-sm text-muted-foreground" datetime={featuredItem.data.pubDate.toISOString()}>
            {featuredItem.data.pubDate.toLocaleDateString(getDateLocale(lang), { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <h2 class="text-2xl md:text-4xl font-extrabold tracking-tight mt-2 mb-3 group-hover:text-accent-yellow transition-colors">
            {featuredItem.data.title}
          </h2>
          <p class="text-muted-foreground md:text-lg line-clamp-2 md:line-clamp-3">
            {featuredItem.data.summary}
          </p>
        </div>
      </a>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {news.map(item => (
        <Card className="flex flex-col h-full border-border/50 hover:border-accent-yellow/50 transition-colors overflow-hidden">
          {item.data.image && (
            isLogo(item.data.image.src) ? (
              <div class="w-full aspect-[4/3] bg-white flex items-center justify-center p-6">
                <img src={item.data.image.src} alt={item.data.image.alt} class="max-h-full max-w-full object-contain" />
              </div>
            ) : (
              <img
                src={item.data.image.src}
                alt={item.data.image.alt}
                class="w-full aspect-[4/3] object-cover"
              />
            )
          )}
          <CardHeader>
            <div class="flex items-center gap-2 mb-2">
              <Badge variant="outline" className="text-[10px] uppercase tracking-wider">
                {tDynamic(lang, `news.category.${item.data.category}`)}
              </Badge>
              <time class="text-sm text-muted-foreground" datetime={item.data.pubDate.toISOString()}>
                {item.data.pubDate.toLocaleDateString(getDateLocale(lang), { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </div>
            <CardTitle className="text-xl line-clamp-2">
              <a
                href={`${translatePath("/news")}/${getSlugFromId(item.id)}`}
                class="hover:text-accent-yellow transition-colors"
              >
                {item.data.title}
              </a>
            </CardTitle>
            <CardDescription className="line-clamp-3 mt-2">
              {item.data.summary}
            </CardDescription>
          </CardHeader>
        </Card>
      ))}
    </div>

    {newsletterItems.length > 0 && (
      <div class="mt-16 md:mt-24">
        <div class="max-w-3xl mb-6">
          <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-3">
            {t("news.newsletter.title")}
          </h2>
          <p class="text-lg text-muted-foreground">
            {t("news.newsletter.banner")}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {newsletterItems.map(item => (
            <Card className="flex flex-col h-full border-border/50 hover:border-accent-yellow/50 transition-colors overflow-hidden">
              {item.data.image && (
                isLogo(item.data.image.src) ? (
                  <div class="w-full aspect-[4/3] bg-white flex items-center justify-center p-6">
                    <img src={item.data.image.src} alt={item.data.image.alt} class="max-h-full max-w-full object-contain" />
                  </div>
                ) : (
                  <img
                    src={item.data.image.src}
                    alt={item.data.image.alt}
                    class="w-full aspect-[4/3] object-cover"
                  />
                )
              )}
              <CardHeader>
                <div class="flex items-center gap-2 mb-2">
                  <Badge variant="outline" className="text-[10px] uppercase tracking-wider">
                    {tDynamic(lang, `news.category.${item.data.category}`)}
                  </Badge>
                  <time class="text-sm text-muted-foreground" datetime={item.data.pubDate.toISOString()}>
                    {item.data.pubDate.toLocaleDateString(getDateLocale(lang), { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                </div>
                <CardTitle className="text-xl line-clamp-2">
                  <a
                    href={`${translatePath("/news")}/${getSlugFromId(item.id)}`}
                    class="hover:text-accent-yellow transition-colors"
                  >
                    {item.data.title}
                  </a>
                </CardTitle>
                <CardDescription className="line-clamp-3 mt-2">
                  {item.data.summary}
                </CardDescription>
              </CardHeader>
            </Card>
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>
